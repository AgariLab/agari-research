    {
      "op": "eval",
      "expression": "(()=>{const roots=[document];for(let i=0;i<roots.length;i++){for(const e of roots[i].querySelectorAll('*'))if(e.shadowRoot)roots.push(e.shadowRoot)}window.tbRoots=roots;return {roots:roots.length,text:roots.filter(r=>r.host?.tagName==='TF-SCALAR-DASHBOARD').map(r=>r.textContent.slice(-18000)),inputs:roots.flatMap(r=>Array.from(r.querySelectorAll('input')).map(e=>({tag:e.tagName,placeholder:e.placeholder,type:e.type,aria:e.getAttribute('aria-label'),value:e.value,id:e.id}))),canvas:roots.flatMap(r=>Array.from(r.querySelectorAll('canvas'))).length,svg:roots.flatMap(r=>Array.from(r.querySelectorAll('svg'))).length}})()"
